# TheKnot Scraper Configuration
# Copy this file to .env and customize as needed

# Browser Settings
THEKNOT_HEADLESS=false
THEKNOT_WINDOW_SIZE=1920,1080

# Timing Settings (seconds)
THEKNOT_MIN_DELAY=3.0
THEKNOT_MAX_DELAY=6.0
THEKNOT_PAGE_LOAD_TIMEOUT=30
THEKNOT_SCROLL_PAUSE=0.5

# Human Behavior Simulation
THEKNOT_ENABLE_MOUSE_MOVEMENT=true
THEKNOT_ENABLE_RANDOM_SCROLLING=true

# Retry Settings
THEKNOT_MAX_RETRIES=3
THEKNOT_RETRY_DELAY=5

# Proxy Settings (optional)
# THEKNOT_PROXY=http://username:password@proxy.example.com:8080
# THEKNOT_PROXY_TYPE=http

# CAPTCHA Settings
THEKNOT_CAPTCHA_WAIT_TIME=60
THEKNOT_AUTO_SOLVE_CAPTCHA=false
# THEKNOT_CAPTCHA_SERVICE_KEY=your_api_key_here

# Output Settings
THEKNOT_OUTPUT_DIR=./output
THEKNOT_SAVE_SCREENSHOTS=true
THEKNOT_SAVE_HTML=false

# Logging
THEKNOT_LOG_LEVEL=INFO
THEKNOT_LOG_FILE=./logs/scraper.log

# Session Management
THEKNOT_SAVE_COOKIES=true
THEKNOT_COOKIE_FILE=./cookies/theknot_cookies.pkl

# User Agent
THEKNOT_ROTATE_USER_AGENT=false
# THEKNOT_CUSTOM_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"
